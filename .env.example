# ---- Backend ----
CODEPROOF_ENV=development            # set to "production" in deployment
DATABASE_URL=sqlite:///./codeproof.db # production: postgresql+psycopg://user:pass@host/db (driver not yet in requirements)
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_SOURCE_BYTES=1000000
JWT_EXP_MINUTES=60
AUTH_RATE_LIMIT=10                   # auth attempts per minute per client IP
ALLOW_PROFESSOR_REGISTRATION=true    # forced to false by default when CODEPROOF_ENV=production
# REQUIRED in production (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# In development an ephemeral secret is used and tokens stop working when the server restarts.
# JWT_SECRET=

# ---- Frontend (public values only; never put secrets in VITE_ variables) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
